NODE_ENV=development
PORT=4000

# --- Database ---
# Runtime connection. In production this MUST be the low-privilege
# `travel_app` role (see docs/RLS.md) - as the owner / a BYPASSRLS role,
# row-level security protects nothing and the API refuses to boot.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel_platform
# Owner role, used only by `pnpm db:migrate` / `db:seed`. Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Used once by `pnpm --filter @travel/database db:setup-app-role` to give travel_app a password.
APP_DB_PASSWORD=
DB_POOL_MAX=20
EVENTS_DB_POOL_MAX=5
REQUIRE_RLS=true

# --- Supabase (production storage/auth backend; optional in local dev) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=travel-platform-media
# Optional: a CDN in front of the bucket (see docs/MEDIA.md). Blank = serve straight from Supabase.
MEDIA_CDN_URL=
# Optional: extra hosts (comma-separated) tenants may link hero videos from, besides Supabase / the CDN.
MEDIA_ALLOWED_VIDEO_HOSTS=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT (generate with: openssl rand -base64 48) ---
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# 32-byte key as 64 hex chars, for encrypting sensitive fields (traveler
# passport numbers) at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Only set during an encryption-key rotation: the OLD key, so existing
# ciphertext stays readable until `pnpm --filter @travel/service-account
# reencrypt` has rewritten it under the new ENCRYPTION_KEY. Remove afterwards.
ENCRYPTION_KEY_PREVIOUS=
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- M-Pesa (Daraja) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
# Public base URL of this API as Safaricom sees it (ngrok URL in dev).
PUBLIC_API_URL=
# >=32 hex chars - authenticates M-Pesa callbacks. Required in production
# whenever MPESA_CONSUMER_KEY is set. Generate with: pnpm secrets:generate
MPESA_CALLBACK_SECRET=
# Optional, comma-separated source IPs allowed to call the M-Pesa callback
# (needs a trusted proxy setting X-Forwarded-For).
MPESA_CALLBACK_IP_ALLOWLIST=
# Confirm "paid" callbacks with Daraja's STK Push Query before crediting.
MPESA_VERIFY_WITH_QUERY=true
# Automated M-Pesa refunds (Daraja Transaction Reversal). Leave blank to refund by hand.
# SECURITY_CREDENTIAL = initiator password RSA-encrypted with Safaricom's cert, base64.
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# SaaS plan billing (separate Stripe webhook endpoint -> its own signing secret):
#   endpoint URL: <PUBLIC_API_URL>/api/v1/billing/webhooks/stripe
#   events: checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_BILLING_WEBHOOK_SECRET=
# Browser origins allowed to call the API cross-origin (comma-separated; "https://*.example.com" for tenant
# subdomains). Leave empty if the web apps use their same-origin proxy. Never credentialed.
CORS_ALLOWED_ORIGINS=
# Where Checkout / Billing Portal return tenants to (the admin app's public URL).
ADMIN_APP_URL=

# --- Email ---
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=bookings@example-travel.com

# --- SMS ---
SMS_PROVIDER=mock
SMS_API_KEY=

# --- WhatsApp ---
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=

# --- Maps (backend; apps/web reads its own NEXT_PUBLIC_ copies below) ---
MAPS_PROVIDER=mock
MAPS_API_KEY=

# apps/web is a separate Next.js build - only NEXT_PUBLIC_ vars reach the
# browser bundle, so the map provider/key needs its own copy here.
# "google" with no key (or left unset) falls back to the keyless
# OpenStreetMap provider automatically - see packages/maps.
NEXT_PUBLIC_MAPS_PROVIDER=
NEXT_PUBLIC_MAPS_API_KEY=

# --- Currency (display-only conversion; see packages/currency) ---
CURRENCY_PROVIDER=static
EXCHANGE_RATE_API_KEY=

# --- apps/web SEO (spec section 38): canonical/OG URLs and sitemap base ---
NEXT_PUBLIC_SITE_URL=https://example-travel.com
# Only a fallback now: each tenant's sitemap/robots/canonical URLs use the host they are served from.
# Platform name/domain shown on the /business-signup page (defaults keep the original NaviMus wording).
# NEXT_PUBLIC_PLATFORM_NAME=NaviMus
# NEXT_PUBLIC_PLATFORM_DOMAIN=NaviMus.travel
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Logging ---
LOG_LEVEL=debug
