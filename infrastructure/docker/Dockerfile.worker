# Same build as Dockerfile.service, but runs a worker entrypoint
# (worker.js) instead of an HTTP server (index.js). Used for
# queue-consuming processes like the notifications worker.
# Usage: docker build --build-arg SERVICE_PATH=services/notifications -f infrastructure/docker/Dockerfile.worker .

FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-workspace.yaml ./
COPY packages ./packages
COPY services ./services
COPY apps ./apps
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG SERVICE_PATH
RUN pnpm --filter "./${SERVICE_PATH}..." build

FROM base AS runner
ARG SERVICE_PATH
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=build /repo .
WORKDIR /repo/${SERVICE_PATH}
CMD ["node", "dist/worker.js"]
