# Browser-visible configuration ONLY. Anything prefixed NEXT_PUBLIC_ is
# embedded in the client bundle and readable by every visitor - never put
# a secret, database URL, or signing key in this file. Backend secrets
# live in the repo-root .env (see .env.example) and are never given to a
# Next.js app: these apps talk to the API gateway and nothing else.
# Browsers talk to THIS app's own /api/v1/* (a same-origin proxy, so the httpOnly
# session cookie is first-party). The proxy and server-side rendering reach the
# API at API_INTERNAL_URL - server-side only, so it is NOT NEXT_PUBLIC_.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Dev only: which tenant to act as when running on localhost (no subdomain).
NEXT_PUBLIC_DEV_TENANT_SLUG=default
